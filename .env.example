# The wedding a URL with no slug renders. Unset falls back to `tema-pink-royal-dream`
# (api.ts), the theme's own demo wedding.
VITE_DEFAULT_SLUG=tema-pink-royal-dream

# Override the API host the dev proxy forwards /api to (default https://api.qinvi.id).
VITE_API_PROXY_TARGET=

# Base path API yang dipanggil dari frontend (production: https://api.qinvi.id/api).
VITE_API_BASE_URL=/api

# Folder di VPS tempat tema ini disajikan. Kosong = /TemaPinkRoyalDream/ (vite.config.ts).
VITE_BASE_PATH=

# 1 = tampilkan isi desain Figma (Mario & Amanda) dan JANGAN memanggil API.
# Kosongkan untuk mengambil data undangan dari slug di URL / VITE_DEFAULT_SLUG.
VITE_DESIGN_MODE=
